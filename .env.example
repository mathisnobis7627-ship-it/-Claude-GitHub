# Base de données PostgreSQL
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas_db

# API
API_PORT=4000
API_URL=http://localhost:4000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# YouTube Data API (pour vidéos éducatives)
YOUTUBE_API_KEY=

# Upload / Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
